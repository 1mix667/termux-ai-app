<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Name"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />
        <EditText
            android:id="@+id/input_provider_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. My OpenAI proxy"
            android:inputType="text" />

        <TextView
            android:id="@+id/label_api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="API key"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />
        <EditText
            android:id="@+id/input_api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Paste API key"
            android:inputType="textPassword" />

        <!-- OpenAI-compatible only section -->
        <LinearLayout
            android:id="@+id/openai_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Base URL"
                android:textStyle="bold"
                android:layout_marginTop="12dp" />
            <EditText
                android:id="@+id/input_base_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="https://api.openai.com"
                android:inputType="textUri" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Endpoint path"
                android:textStyle="bold"
                android:layout_marginTop="12dp" />
            <EditText
                android:id="@+id/input_endpoint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="/v1/chat/completions"
                android:inputType="text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Authorization scheme"
                android:textStyle="bold"
                android:layout_marginTop="12dp" />
            <Spinner
                android:id="@+id/spinner_auth_scheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Custom headers (one per line: Name: value)"
                android:textStyle="bold"
                android:layout_marginTop="12dp" />
            <EditText
                android:id="@+id/input_custom_headers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="X-Custom-Header: value"
                android:inputType="textMultiLine"
                android:minLines="2" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="System prompt"
                android:textStyle="bold"
                android:layout_marginTop="12dp" />
            <EditText
                android:id="@+id/input_system_prompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="You are a helpful assistant..."
                android:inputType="textMultiLine"
                android:minLines="3" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Temperature"
                        android:textStyle="bold" />
                    <EditText
                        android:id="@+id/input_temperature"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="0.7"
                        android:inputType="numberDecimal" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Max tokens"
                        android:textStyle="bold" />
                    <EditText
                        android:id="@+id/input_max_tokens"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="1024"
                        android:inputType="number" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/model_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/label_model"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Model"
                android:textStyle="bold"
                android:layout_marginTop="12dp" />
            <EditText
                android:id="@+id/input_model"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="gpt-4o-mini"
                android:inputType="text" />
        </LinearLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enabled"
            android:layout_marginTop="16dp"
            android:checked="true" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_provider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Provider"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
